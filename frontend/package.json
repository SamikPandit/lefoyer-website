{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/optimize-images.mjs --quiet && vite",
    "prebuild": "node scripts/optimize-images.mjs --check",
    "build": "node scripts/gen-sitemap.mjs && vite build && node scripts/optimize-images.mjs --prune-dist",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "sitemap": "node scripts/gen-sitemap.mjs",
    "images": "node scripts/optimize-images.mjs",
    "images:check": "node scripts/optimize-images.mjs --check",
    "images:force": "node scripts/optimize-images.mjs --force --check"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "axios": "^1.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.53.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "sharp": "^0.33.5",
    "vite": "^5.0.0"
  }
}
